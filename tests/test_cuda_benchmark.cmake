function(expect_error)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status STREQUAL "1" OR NOT err MATCHES "fluid_cuda_benchmark:")
        message(FATAL_ERROR "Expected benchmark error for '${ARGN}': ${status} ${out} ${err}")
    endif()
endfunction()
expect_error(--particles 100000)
expect_error(--particles -1)
expect_error(--steps 0)
expect_error(--steps 1junk)
expect_error(--warmup 100001)
expect_error(--particles 128 --particles 128)

execute_process(COMMAND "${PROGRAM}" --particles 129 --warmup 1 --steps 3 --output "${OUTPUT_DIR}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Benchmark smoke failed: ${status} ${out} ${err}")
endif()
file(STRINGS "${OUTPUT_DIR}/samples.csv" samples)
list(LENGTH samples sample_lines)
if(NOT sample_lines EQUAL 4)
    message(FATAL_ERROR "Expected CSV header and three timing samples")
endif()
file(STRINGS "${OUTPUT_DIR}/summary.csv" summary)
list(LENGTH summary summary_lines)
if(NOT summary_lines EQUAL 2)
    message(FATAL_ERROR "Expected summary header and one measurement row")
endif()
list(GET samples 0 header)
if(NOT header STREQUAL "sample,density_pressure_ms,forces_ms,integrate_ms,total_ms")
    message(FATAL_ERROR "Missing per-stage sample columns")
endif()
list(GET summary 1 record)
if(NOT record MATCHES ",129,1,3,42,")
    message(FATAL_ERROR "Missing reproducible N/warmup/steps/seed metadata: ${record}")
endif()
