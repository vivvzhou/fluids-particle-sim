if(NOT DEFINED PROGRAM OR NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "PROGRAM and OUTPUT_DIR are required")
endif()

function(expect_error)
    execute_process(COMMAND "${PROGRAM}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT status STREQUAL "1" OR NOT err MATCHES "fluid_sim:")
        message(FATAL_ERROR "Expected actionable exit 1 for '${ARGN}'; got ${status}: ${out} ${err}")
    endif()
endfunction()

expect_error(--particles 0)
expect_error(--particles -1)
expect_error(--particles 4294967296)
expect_error(--particles 12junk)
expect_error(--particles 4097)
expect_error(--dt 0)
expect_error(--dt nan)
expect_error(--dt inf)
expect_error(--dt 1e-99)
expect_error(--dt 0.001junk)
expect_error(--dt)
expect_error(--seed -1)
expect_error(--scene invalid)
expect_error(--backend invalid)
expect_error(--backend cuda --particles 100000)
expect_error(--backend cuda --particles 50001)
expect_error(--backend cuda --neighbor-search all-pairs --particles 4097)
expect_error(--backend cuda --neighbor-search invalid)
expect_error(--neighbor-search grid)
expect_error(--backend cuda --neighbor-search grid --neighbor-search all-pairs)
expect_error(--benchmark)
expect_error(--jitter 0.2)
expect_error(--restitution 1.1)
expect_error(--viscosity -1)
expect_error(--spacing 1)
expect_error(--particles 128 --particles 128)
expect_error(--help --steps 0)

execute_process(COMMAND "${PROGRAM}" --scene dam-break --backend cpu --particles 128 --steps 3
    --seed 42 --dump-every 2 --output "${OUTPUT_DIR}/run"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status STREQUAL "0" OR NOT out MATCHES "Completed 3 steps")
    message(FATAL_ERROR "CLI smoke failed (${status}): ${out} ${err}")
endif()
foreach(frame IN ITEMS 000000 000002 000003)
    if(NOT EXISTS "${OUTPUT_DIR}/run/frame_${frame}.ply")
        message(FATAL_ERROR "Missing requested PLY frame ${frame}")
    endif()
endforeach()
if(EXISTS "${OUTPUT_DIR}/run/frame_000001.ply")
    message(FATAL_ERROR "Unexpected off-interval frame")
endif()

execute_process(COMMAND "${PROGRAM}" --particles 128 --steps 0 --spacing 0.04 --dump-every 1
    --output "${OUTPUT_DIR}/initial" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status STREQUAL "0" OR NOT out MATCHES "Completed 0 steps" OR
   NOT out MATCHES "h=0.079" OR NOT EXISTS "${OUTPUT_DIR}/initial/frame_000000.ply")
    message(FATAL_ERROR "Initial-only export/derived h failed (${status}): ${out} ${err}")
endif()

execute_process(COMMAND "${PROGRAM}" --particles 128 --steps 1 --output "${OUTPUT_DIR}/disabled"
    RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE err)
if(NOT status STREQUAL "0" OR EXISTS "${OUTPUT_DIR}/disabled")
    message(FATAL_ERROR "Disabled export should not create a directory: ${status} ${err}")
endif()

if(NOT HAS_CUDA)
    expect_error(--backend cuda)
    execute_process(COMMAND "${PROGRAM}" --device-info RESULT_VARIABLE status OUTPUT_VARIABLE out)
    if(NOT status STREQUAL "2" OR NOT out MATCHES "unavailable")
        message(FATAL_ERROR "CPU build must explicitly report CUDA unavailability")
    endif()
endif()
